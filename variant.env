# strata-xtx: welke variant dit is. Bepaalt namen en paden, zodat varianten naast elkaar in één container passen.
XTX_NAME=strata-xtx                 # service-, config-, log- en state-naam
CMD_PREFIX=xtx                      # commando's in /usr/local/bin: xtx-update, xtx-bench, ...
STRATA_DIR_DEFAULT=/opt/ai/strata   # eigen clone van upstream (eigen .venv met ROCm)
ROCM_VERSION_DEFAULT=               # leeg = setup's geteste ROCm-wheels
CONFLICTS="strata-xtx-rocm10 strata-xtx-rocm714"   # andere varianten op dezelfde GPU/poort (nooit tegelijk)
